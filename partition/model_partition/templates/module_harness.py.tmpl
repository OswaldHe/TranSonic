"""Standalone replay harness for partition module group `{{ signature }}`.

Generated by model_partition. One implementation shared by {{ module_ids | length }} module(s):
{% for module_id in module_ids %}  - {{ module_id }}{% if layer_map[module_id] %}  layers {{ layer_map[module_id] | join(', ') }}{% endif %}
{% endfor %}
Root class: {{ class_name }}
The real implementation's source is in `source.py` beside this file.

Replays the module from its dumped weights and input feature map. The original
checkpoint is not needed — only the model's config/code (for structure) and the
artifacts in the run directory.

    python module.py --run {{ run_root }}
    python module.py --run {{ run_root }} --module {{ module_ids[-1] }} --sample {{ sample_ids[0] if sample_ids else 'SAMPLE' }}
"""

from __future__ import annotations

import argparse
import sys
from pathlib import Path

MODULE_IDS = {{ module_ids | tojson }}
LAYER_MAP = {{ layer_map | tojson }}
SIGNATURE = {{ signature | tojson }}
CLASS_NAME = {{ class_name | tojson }}
SAMPLE_IDS = {{ sample_ids | tojson }}
WEIGHT_TENSORS = {{ weight_tensors | tojson }}
DEFAULT_RUN = {{ run_root | tojson }}


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(description="Replay this partition module from artifacts.")
    parser.add_argument("--run", type=Path, default=Path(DEFAULT_RUN),
                        help="Run directory holding run.yaml, plan/ and trace/")
    parser.add_argument("--module", default=MODULE_IDS[0], choices=MODULE_IDS)
    parser.add_argument("--sample", default=None, help="Sample id (default: first traced)")
    parser.add_argument("--device", default="cpu")
    args = parser.parse_args(argv)

    from model_partition.runtime.standalone import StandaloneError, replay_module

    print(f"group    : {SIGNATURE}")
    print(f"class    : {CLASS_NAME}")
    print(f"module   : {args.module}  layers={LAYER_MAP.get(args.module) or '-'}")
    print(f"weights  : {len(WEIGHT_TENSORS.get(args.module, []))} dumped tensors")
    try:
        comparisons = replay_module(args.run, args.module, args.sample, device=args.device)
    except StandaloneError as exc:
        print(f"error: {exc}", file=sys.stderr)
        return 2

    for comparison in comparisons:
        print("  " + comparison.summary())
    return 0 if all(c.passed for c in comparisons) else 1


if __name__ == "__main__":
    raise SystemExit(main())
