"""Inference for partition module group `{{ signature }}`.

Generated by model_partition. One implementation shared by {{ module_ids | length }} module(s):
{% for module_id in module_ids %}  - {{ module_id }}{% if layer_map[module_id] %}  layers {{ layer_map[module_id] | join(', ') }}{% endif %}
{% endfor %}
Root class: {{ class_name }}  (real source in `source.py` beside this file)

Runs the module from its dumped input feature map and dumped weights. The original
checkpoint is not needed: structure comes from the model's config and code, every
weight from the artifacts.

    python inference.py                                   # first module, first sample
    python inference.py --module {{ module_ids[-1] }}{{ ' ' }}
    python inference.py --device cuda --save out.bin

`verify.py` beside this file checks the output against the dumped reference.
"""

from __future__ import annotations

import argparse
import sys
from pathlib import Path

MODULE_IDS = {{ module_ids | tojson }}
LAYER_MAP = {{ layer_map | tojson }}
SIGNATURE = {{ signature | tojson }}
CLASS_NAME = {{ class_name | tojson }}
SAMPLE_IDS = {{ sample_ids | tojson }}
WEIGHT_TENSORS = {{ weight_tensors | tojson }}
DEFAULT_RUN = {{ run_root | tojson }}


def run(run_dir=DEFAULT_RUN, module_id=None, sample_id=None, device="cpu"):
    """Run this module's inference; returns one ModuleCall per submodule call."""
    from model_partition.runtime.standalone import run_module

    return run_module(run_dir, module_id or MODULE_IDS[0], sample_id, device=device)


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(description="Run this partition module's inference.")
    parser.add_argument("--run", type=Path, default=Path(DEFAULT_RUN),
                        help="Run directory holding run.yaml, plan/ and trace/")
    parser.add_argument("--module", default=MODULE_IDS[0], choices=MODULE_IDS)
    parser.add_argument("--sample", default=None, help="Sample id (default: first traced)")
    parser.add_argument("--device", default="cpu")
    parser.add_argument("--save", type=Path, default=None,
                        help="Write the final output tensor as a raw .bin")
    return parser


def main(argv: list[str] | None = None) -> int:
    args = build_parser().parse_args(argv)

    from model_partition.runtime.module_runner import first_tensor
    from model_partition.runtime.standalone import StandaloneError

    print(f"group    : {SIGNATURE}")
    print(f"class    : {CLASS_NAME}")
    print(f"module   : {args.module}  layers={LAYER_MAP.get(args.module) or '-'}")
    print(f"weights  : {len(WEIGHT_TENSORS.get(args.module, []))} dumped tensors")
    try:
        calls = run(args.run, args.module, args.sample, device=args.device)
    except StandaloneError as exc:
        print(f"error: {exc}", file=sys.stderr)
        return 2

    final = None
    for call in calls:
        tensor = first_tensor(call.output)
        final = tensor if tensor is not None else final
        shape = tuple(tensor.shape) if tensor is not None else None
        print(f"  {call.submodule}: output shape={shape} "
              f"dtype={getattr(tensor, 'dtype', None)}")

    if args.save is not None and final is not None:
        from model_partition.tensorstore import contiguous_bytes

        raw, dtype, shape = contiguous_bytes(final)
        args.save.write_bytes(raw)
        print(f"wrote {args.save}  ({dtype} {tuple(shape)}, {len(raw)} bytes)")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
