"""Inference implementation for partition module group `{{ signature }}`.

EDITABLE — this file is the loop's. When verification reports a numerical
mismatch, this is what gets fixed. `verify.py` beside it is the harness's and is
not editable: it decides whether this implementation is correct.

Shared by {{ module_ids | length }} module(s):
{% for module_id in module_ids %}  - {{ module_id }}{% if layer_map[module_id] %}  layers {{ layer_map[module_id] | join(', ') }}{% endif %}
{% endfor %}
## The contract

    build_module(config, weights, device) -> callable

`weights` is keyed by original parameter name, e.g.
{% if weight_names %}    {{ weight_names[0] }}
{% endif %}The returned callable is invoked with the arguments the module actually received
during tracing, and its output is compared against the dumped reference.

## Where to start

The baseline below instantiates the model's own class and loads the dumped
weights into it, so it is correct from the outset. Replace its body with an
explicit implementation when you need one — for porting to a Trainium kernel, or
because the module should be expressed in simpler operations. `source.py` beside
this file holds the real implementation's source to work from.

Whatever you write, `verify.py` must still pass:

    python verify.py --all-modules --all-samples
"""

from __future__ import annotations

MODULE_IDS = {{ module_ids | tojson }}
LAYER_MAP = {{ layer_map | tojson }}
SIGNATURE = {{ signature | tojson }}
CLASS_NAME = {{ class_name | tojson }}
SUBMODULES = {{ submodules | tojson }}
WEIGHT_NAMES = {{ weight_names | tojson }}
DEFAULT_RUN = {{ run_root | tojson }}


def build_module(config, weights, device="cpu"):
    """Return a callable that computes this module's forward.

    Baseline: build the model's structure from its config and code, then load the
    dumped weights for this module. Nothing is read from the original checkpoint.
    """
    from model_partition.runtime.baseline import build_from_dumps

    return build_from_dumps(config, weights, device=device,
                            run_dir=DEFAULT_RUN, module_ids=MODULE_IDS)


def main(argv=None):
    """Run this module once and report its output shapes.

    A convenience for inspecting the implementation; `verify.py` is what decides
    whether it is correct.
    """
    import argparse
    import sys

    parser = argparse.ArgumentParser(description="Run this module's inference once.")
    parser.add_argument("--run", default=DEFAULT_RUN, help="Run directory")
    parser.add_argument("--module", default=MODULE_IDS[0], choices=MODULE_IDS)
    parser.add_argument("--sample", default=None)
    parser.add_argument("--device", default="cpu")
    parser.add_argument("--save", default=None, help="Write the output as a raw .bin")
    args = parser.parse_args(argv)

    from model_partition.runtime.module_impl import ExtractedImpl, run_impl
    from model_partition.runtime.module_runner import (
        decode_call, first_tensor, load_named_weights,
    )
    from model_partition.runtime.standalone import StandaloneError, load_run

    try:
        run = load_run(args.run)
        sample = args.sample or (run.bundle.sample_ids() or [None])[0]
        records = run.bundle.select(module_id=args.module, sample_id=sample)
        if not records:
            raise StandaloneError(f"No records for {args.module} sample {sample}")
        weights = load_named_weights(run.bundle, args.module, device=args.device)
        args_, kwargs_ = decode_call(records[0], run.bundle.store, args.device)
    except StandaloneError as exc:
        print(f"error: {exc}", file=sys.stderr)
        return 2

    print(f"group    : {SIGNATURE}")
    print(f"module   : {args.module}  layers={LAYER_MAP.get(args.module) or '-'}")
    print(f"weights  : {len(weights)} dumped tensors")

    impl = ExtractedImpl(path=__file__, module=sys.modules[__name__],
                         module_ids=MODULE_IDS)
    output = run_impl(impl, run.bundle.metadata.get("config") or {},
                      weights, args_, kwargs_, device=args.device)
    tensor = first_tensor(output)
    print(f"  output shape={tuple(tensor.shape) if tensor is not None else None} "
          f"dtype={getattr(tensor, 'dtype', None)}")

    if args.save and tensor is not None:
        from model_partition.tensorstore import contiguous_bytes

        raw, dtype, shape = contiguous_bytes(tensor)
        with open(args.save, "wb") as handle:
            handle.write(raw)
        print(f"wrote {args.save}  ({dtype} {tuple(shape)}, {len(raw)} bytes)")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
