"""Inference implementation for partition module group `{{ signature }}`.

EDITABLE — this file is the loop's. When verification reports a numerical
mismatch, this is what gets fixed. `verify.py` beside it is the harness's and is
not editable: it decides whether this implementation is correct.

Shared by {{ module_ids | length }} module(s):
{% for module_id in module_ids %}  - {{ module_id }}{% if layer_map[module_id] %}  layers {{ layer_map[module_id] | join(', ') }}{% endif %}
{% endfor %}
## The contract

    build_module(config, weights, device, submodule=None) -> callable

`config` is the model's resolved config; `weights` is keyed by original parameter
name, e.g.
{% if weight_names %}    {{ weight_names[0] }}
{% endif %}The returned callable is invoked with the arguments the module actually received
during tracing, and every tensor it returns is compared against the dumped
reference.

`submodule` names which branch to run and matters only for a `parallel` group — a
set of MoE experts, where one recorded call exercises one expert. Drop it from the
signature if this module has a single submodule.

## What runs

`source.py` beside this file **is** the implementation. This launcher imports it,
constructs {{ class_names | join(' then ') }} from the recorded config, loads the
dumped weights in, and returns the module. Nothing reads the checkpoint and nothing
instantiates the rest of the model, so this directory is a unit you can optimize on
its own.

Optimize `source.py`. Then:

    python inference.py                              # run it
    python verify.py --all-modules --all-samples     # is it still correct?
"""

from __future__ import annotations

MODULE_IDS = {{ module_ids | tojson }}
LAYER_MAP = {{ layer_map | tojson }}
SIGNATURE = {{ signature | tojson }}
CLASS_NAME = {{ class_name | tojson }}
#: One class per submodule of a module in this group, in order.
CLASS_NAMES = {{ class_names | tojson }}
SUBMODULES = {{ submodules | tojson }}
MODULE_SUBMODULES = {{ module_submodules | tojson }}
#: Dotted name source.py's classes were defined under, so its own imports resolve.
SOURCE_MODULE = {{ source_module | tojson }}
#: The config class these modules are constructed with, recorded rather than guessed.
CONFIG_CLASS = {{ config_class | tojson }}
LAUNCHABLE = {{ 'True' if launchable else 'False' }}
COMPOSITION = {{ composition | tojson }}
WEIGHT_NAMES = {{ weight_names | tojson }}
DEFAULT_RUN = {{ run_root | tojson }}


def build_module(config, weights, device="cpu", submodule=None):
    """Launch this module's implementation from `source.py`.

    Constructs one instance per submodule from the source in this directory, loads the
    recorded weights into each, and returns the module — the chain of them when the
    group spans more than one. `submodule` asks for a single piece: which expert of a
    parallel group, or which submodule when these are installed into a model.
    """
    from pathlib import Path

    from model_partition.runtime.launcher import build_group

    return build_group(
        Path(__file__).resolve().parent, config, weights, device=device,
        source_module=SOURCE_MODULE, class_names=CLASS_NAMES,
        config_class=CONFIG_CLASS, submodules=MODULE_SUBMODULES,
        layer_map=LAYER_MAP, submodule=submodule,
    )


def main(argv=None):
    """Run this module once and report its output shapes.

    A convenience for inspecting the implementation; `verify.py` is what decides
    whether it is correct.
    """
    import argparse
    import sys

    parser = argparse.ArgumentParser(description="Run this module's inference once.")
    parser.add_argument("--run", default=DEFAULT_RUN, help="Run directory")
    parser.add_argument("--module", default=MODULE_IDS[0], choices=MODULE_IDS)
    parser.add_argument("--sample", default=None)
    parser.add_argument("--device", default="cpu")
    parser.add_argument("--save", default=None, help="Write the output as a raw .bin")
    args = parser.parse_args(argv)

    from model_partition.runtime.module_impl import ExtractedImpl, run_impl
    from model_partition.runtime.module_runner import (
        decode_group_call, first_tensor, load_named_weights,
    )
    from model_partition.runtime.standalone import StandaloneError, load_run

    try:
        run = load_run(args.run)
        sample = args.sample or (run.bundle.sample_ids() or [None])[0]
        records = run.bundle.select(module_id=args.module, sample_id=sample)
        if not records:
            raise StandaloneError(f"No records for {args.module} sample {sample}")
        weights = load_named_weights(run.bundle, args.module, device=args.device)
        args_, kwargs_ = decode_group_call(records, run.bundle.store, args.device)
    except StandaloneError as exc:
        print(f"error: {exc}", file=sys.stderr)
        return 2

    print(f"group    : {SIGNATURE}")
    print(f"module   : {args.module}  layers={LAYER_MAP.get(args.module) or '-'}")
    print(f"weights  : {len(weights)} dumped tensors")

    impl = ExtractedImpl(path=__file__, module=sys.modules[__name__],
                         module_ids=MODULE_IDS)
    output = run_impl(impl, run.bundle.config, weights, args_, kwargs_,
                      device=args.device, submodule=records[0].submodule)
    tensor = first_tensor(output)
    print(f"  output shape={tuple(tensor.shape) if tensor is not None else None} "
          f"dtype={getattr(tensor, 'dtype', None)}")

    if args.save and tensor is not None:
        from model_partition.tensorstore import contiguous_bytes

        raw, dtype, shape = contiguous_bytes(tensor)
        with open(args.save, "wb") as handle:
            handle.write(raw)
        print(f"wrote {args.save}  ({dtype} {tuple(shape)}, {len(raw)} bytes)")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
